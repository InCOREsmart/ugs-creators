{
  "name": "ugs-creators",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev:web": "pnpm --filter @ugs/frontend dev",
    "dev:api": "pnpm --filter @ugs/api dev",
    "dev:worker": "pnpm --filter @ugs/worker dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @ugs/api db:generate",
    "db:push": "pnpm --filter @ugs/api db:push",
    "db:migrate": "pnpm --filter @ugs/api db:migrate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
