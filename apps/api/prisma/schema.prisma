generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  MANAGER
  CREATOR
}
enum CampaignStatus {
  SEARCH
  NEGOTIATION
  BRIEF_ACCEPTED
  CONTRACT
  CONTENT_CREATION
  APPROVAL
  PUBLICATION
  PAYMENT
  COMPLETED
  CANCELLED
}
enum CreatorTaxStatus {
  SELF_EMPLOYED
  IP
  INDIVIDUAL
}
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  fullName     String
  role         UserRole @default(MANAGER)
  isActive     Boolean  @default(true)
  refreshHash  String?
  creator      Creator?
  memberships  OrganizationMember[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  legalName String?
  inn       String?
  createdAt DateTime @default(now())
  campaigns Campaign[]
  members   OrganizationMember[]
}
model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           UserRole     @default(MANAGER)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  @@unique([organizationId, userId])
  @@index([userId, role])
}
model Campaign {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id])
  name           String
  status         CampaignStatus @default(SEARCH)
  budgetKopecks  BigInt         @default(0)
  deadline       DateTime?
  createdBy      String         @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  mediaAssets    MediaAsset[]
  @@index([organizationId, status])
}

enum MediaAssetStatus {
  UPLOAD_PENDING
  QUEUED
  PROCESSING
  READY
  FAILED
}

model MediaAsset {
  id             String           @id @default(uuid()) @db.Uuid
  campaignId     String           @db.Uuid
  campaign       Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy      String           @db.Uuid
  objectKey      String           @unique
  fileName       String
  contentType    String
  originalBytes  BigInt
  status         MediaAssetStatus @default(UPLOAD_PENDING)
  jobId          String?
  durationSeconds Float?
  width          Int?
  height         Int?
  variants       Json?
  thumbnailKey   String?
  errorMessage   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  @@index([campaignId, status])
  @@index([createdBy, createdAt])
}
model Creator {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @unique @db.Uuid
  user             User            @relation(fields: [userId], references: [id])
  displayName      String
  taxStatus        CreatorTaxStatus @default(INDIVIDUAL)
  priceList        Json            @default("{}")
  audienceMetrics  Json            @default("{}")
  engagementRate   Decimal?        @db.Decimal(7,4)
  fraudScore       Decimal?        @db.Decimal(5,2)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  @@index([displayName])
}
